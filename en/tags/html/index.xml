    <item>
      <title>HTML Introduction | HTML5 Multimedia</title>
      <link>https://www.devkuma.com/en/docs/html/html5-multimedia/</link>
      <pubDate>Sun, 02 Jul 2017 00:45:25 +0900</pubDate>
      <author>kc@example.com (kc kim)</author>
      <guid>https://www.devkuma.com/en/docs/html/html5-multimedia/</guid>
      <description>
        
        
        &lt;h2 id=&#34;multimedia-elements-added-in-html5&#34;&gt;Multimedia Elements Added in HTML5&lt;/h2&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;Multimedia element&lt;/th&gt;
					&lt;th&gt;Description&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;audio&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Specifies audio files, such as sound and music.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;embed&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Specifies an object, such as a plug-in, to embed in an HTML document.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;source&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Specifies multiple file formats and file URLs for the source of a multimedia element.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;track&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Specifies text tracks for a video player, such as captions or subtitles.&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;video&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;Specifies video files, such as videos and movies.&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;

      </description>
      
      <category>HTML</category>
      
      <category>Web</category>
      
    </item>
    
