    <item>
      <title>SyntaxHighlighter</title>
      <link>https://www.devkuma.com/en/docs/syntaxhighlighter/</link>
      <pubDate>Tue, 10 Dec 2019 01:18:45 +0900</pubDate>
      <author>kc@example.com (kc kim)</author>
