    <item>
      <title>HTML入門 | HTML5マルチメディア</title>
      <link>https://www.devkuma.com/jp/docs/html/html5-multimedia/</link>
      <pubDate>Sun, 02 Jul 2017 00:45:25 +0900</pubDate>
      <author>kc@example.com (kc kim)</author>
      <guid>https://www.devkuma.com/jp/docs/html/html5-multimedia/</guid>
      <description>
        
        
        &lt;h2 id=&#34;html5で追加されたマルチメディア要素&#34;&gt;HTML5で追加されたマルチメディア要素&lt;/h2&gt;
&lt;table&gt;
	&lt;thead&gt;
			&lt;tr&gt;
					&lt;th&gt;マルチメディア要素&lt;/th&gt;
					&lt;th&gt;説明&lt;/th&gt;
			&lt;/tr&gt;
	&lt;/thead&gt;
	&lt;tbody&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;audio&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;音声や音楽などのオーディオファイルを指定する。&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;embed&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;HTML文書に埋め込むプラグイン（plug-in）などのオブジェクト（object）を指定する。&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;source&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;マルチメディア要素のソースについて、複数のファイル形式やファイルURLを指定するときに使用する。&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;track&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;動画プレーヤー用のテキスト字幕を指定するときに使用する。&lt;/td&gt;
			&lt;/tr&gt;
			&lt;tr&gt;
					&lt;td&gt;&lt;code&gt;&amp;lt;video&amp;gt;&lt;/code&gt;&lt;/td&gt;
					&lt;td&gt;動画や映画などのビデオファイルを指定するときに使用する。&lt;/td&gt;
			&lt;/tr&gt;
	&lt;/tbody&gt;
&lt;/table&gt;

      </description>
      
      <category>HTML</category>
      
      <category>Web</category>
      
    </item>
    
